{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Vulnobs",
  "id": "rupesh-vulnobs-app",
  "backend": true,
  "executable": "gpx_vulnobs",
  "info": {
    "keywords": ["app", "security", "vulnerability", "cve", "osv", "observability"],
    "description": "Vulnerability observability in Grafana — search public CVE feeds (OSV) and see which vulnerabilities affect your scanned containers and repositories.",
    "author": {
      "name": "Rupesh Punna",
      "url": "https://github.com/rupeshkoushik07"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Website",
        "url": "https://github.com/rupeshkoushik07/grafana-vulnobs"
      },
      {
        "name": "Report an issue",
        "url": "https://github.com/rupeshkoushik07/grafana-vulnobs/issues"
      }
    ],
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Search",
      "path": "/a/%PLUGIN_ID%/search",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "Scan",
      "path": "/a/%PLUGIN_ID%/scan",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
