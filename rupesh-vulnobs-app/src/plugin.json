{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Vulnobs",
  "id": "rupeshkoushik07-vulnobs-app",
  "backend": true,
  "executable": "gpx_vulnobs",
  "info": {
    "keywords": [
      "app",
      "security",
      "vulnerability",
      "cve",
      "osv",
      "observability"
    ],
    "description": "Vulnerability observability in Grafana \u2014 search public CVE feeds (OSV) and see which vulnerabilities affect your scanned containers and repositories.",
    "author": {
      "name": "Rupesh Punna",
      "url": "https://github.com/rupeshkoushik07"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Website",
        "url": "https://github.com/rupeshkoushik07/grafana-vulnobs"
      },
      {
        "name": "Report an issue",
        "url": "https://github.com/rupeshkoushik07/grafana-vulnobs/issues"
      }
    ],
    "screenshots": [
      {
        "name": "Asset Detail",
        "path": "img/screenshots/asset-detail.png"
      },
      {
        "name": "Assets",
        "path": "img/screenshots/assets.png"
      },
      {
        "name": "Dashboard",
        "path": "img/screenshots/dashboard.png"
      },
      {
        "name": "Scan Cyclonedx",
        "path": "img/screenshots/scan-cyclonedx.png"
      },
      {
        "name": "Scan Trivy",
        "path": "img/screenshots/scan-trivy.png"
      },
      {
        "name": "Search Cve",
        "path": "img/screenshots/search-cve.png"
      },
      {
        "name": "Search",
        "path": "img/screenshots/search.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Search",
      "path": "/a/%PLUGIN_ID%/search",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "Scan",
      "path": "/a/%PLUGIN_ID%/scan",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Assets",
      "path": "/a/%PLUGIN_ID%/assets",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    },
    {
      "type": "datasource",
      "name": "Vulnobs OSV",
      "path": "datasource/plugin.json"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
